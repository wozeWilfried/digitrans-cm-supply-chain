# ================================================================
#  DIGITRANS-SCM — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
#  NE JAMAIS committer le fichier .env
# ================================================================

# ─── MySQL ────────────────────────────────────────────────────────
MYSQL_DATABASE=digitrans_scm
MYSQL_USER=digitrans_user
MYSQL_PASSWORD=changeme_strong_password
MYSQL_ROOT_PASSWORD=changeme_root_password

# ─── Spring Boot ─────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/digitrans_scm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Douala&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=digitrans_user
SPRING_DATASOURCE_PASSWORD=changeme_strong_password

# ─── JWT ─────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET=changeme_generate_a_very_long_random_secret_key_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ─── Redis ───────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ─── Frontend ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ─── AWS (Staging / Prod) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
ECR_REGISTRY=

# ─── SonarQube ───────────────────────────────────────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
